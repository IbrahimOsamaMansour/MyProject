@model Project.Models.Bill

@{
    ViewData["Title"] = "Details";
    Layout = "~/Views/Shared/_CustomLayout.cshtml";
    double totalpayed = Model.PayedQuantities?.Sum(p => (double)p.value) ?? 0.0;
    double? remainingQ = Model.Total_Price - totalpayed;
}



<div class="">
    <div class="page-title">
        <div class="title_left">
            <h3>Invoice</h3>
        </div>
        <div class="title_right no-print">
            <button type="button" class="btn btn-primary" onclick="window.print();">
                <i class="fa fa-print"></i> Print / Save as PDF
            </button>
        </div>

       @* <div class="title_right">
            <div class="col-md-5 col-sm-5   form-group pull-right top_search">
                <div class="input-group">
                    <input type="text" class="form-control" placeholder="Search for...">
                    <span class="input-group-btn">
                        <button class="btn btn-secondary" type="button">Go!</button>
                    </span>
                </div>
            </div>
        </div>*@
    </div>

    <div class="clearfix"></div>

    <div class="row">
        <div class="col-md-12">
            <div class="x_panel invoice-print">
                <div class="x_title">
                    <h2>Invoice <small>to Ceramic trade </small></h2>
                    <ul class="nav navbar-right panel_toolbox no-print">
                        <li>
                            <a class="collapse-link"><i class="fa fa-chevron-up"></i></a>
                        </li>
                        <li>
                            <a class="close-link"><i class="fa fa-close"></i></a>
                        </li>
                    </ul>
                    <div class="clearfix"></div>
                </div>
                <div class="x_content">

                    <section class="content invoice">
                        <!-- title row -->
                        <div class="row">
                            <div class="  invoice-header">
                                
                            @if(TempData["resultDeleteProduct"] != null){
                                <h5 class="alert alert-info no-print">@TempData["resultDeleteProduct"]</h5>
                            }
                            @if (TempData["resultConfirm"] != null){
                                <h5 class="alert alert-info no-print">@TempData["resultConfirm"]</h5>
                            }
                                <h1>
                                    <i class="fa fa-globe"></i> Invoice.
                                    <small class="pull-right">Date: @Model.Date.ToShortDateString() </small>
                                </h1>
                            </div>
                            <!-- /.col -->
                        </div>
                        <!-- info row -->
                        <div class="row invoice-info">
                            <div class="col-sm-4 invoice-col">
                                From
                                <address>
                                    <strong>Ceramica Cleopatra.</strong>
                                    <br>Eastern Helwan
                                    <br />Riyadh Street Intersection, Ismail Kamel,
                                    <br />Cairo Governorate
                                    <br>Phone: 01001688621
                                    <br>Email: kareemsaeed1@yahoo.com
                                </address>
                            </div>
                            <!-- /.col -->
                            <div class="col-sm-4 invoice-col">
                                To
                                <address>
                                    <strong>@Model.Client_Name</strong>
                                    <br>Phone: @Model.Client_phone                                  
                                </address>
                            </div>
                            <!-- /.col -->
                            <div class="col-sm-4 invoice-col">
                                <b>Invoice #@Model.Bill_Num
                                <br />Exp Date: @Model.Exp_Date
                                </b>
                                @*<br>
                                <br>
                                <b>Order ID:</b> 4F3S8J
                                <br>
                                <b>Payment Due:</b> 2/22/2014
                                <br>
                                <b>Account:</b> 968-34567*@
                            </div>
                            <!-- /.col -->
                        </div>
                        <!-- /.row -->
                        <!-- Table row -->
                        <div class="row">
                            <div class="  table">
                         
                                <table class="table table-striped">
                                    <thead>
                                        <tr>
                                            
										    <th>Qty</th>
                                            <th>Product</th>
										    <th>unit price </th>
                                            <th>Total</th>
                                            <th class="screen-only">product is sold</th>
                                            <th class="screen-only">Sell Date</th>
                                            <th class="screen-only">Book Date</th>
                                            <th class="no-print"></th>

                                        </tr>
                                    </thead>
                                    <tbody>
                                    @if (Model.Product_Bills.Count != 0)
                                    {
                                        @foreach (var item in Model.Product_Bills){
                                               <tr>
                                                    <td>@item.Quantity @item.unit_Quantity</td>
                                                    <td>@item.product.ModelName</td>
                                                    <td>@item.unit_Price LE</td>
                                                    <td>@(((item.unit_Price ?? 0) * (item.Quantity ?? 0)).ToString("0.##")) LE</td>
                                                    <td class="screen-only">@item.Resv_Q_State</td>
                                                    <td class="screen-only">@item.Sell_Date</td>
                                                    <td class="screen-only">@item.Book_Date</td>
                                                    <td class="no-print"> <a asp-action="Delete" asp-controller="BillProduct" asp-route-id="@item.ID" class="btn btn-danger" onclick="return DeleteItem()">Delete</a></td>
                                                
                                             </tr>
                                        }
                                     
                                    }else{
                                        <tr> <td colspan="8" style="text-align:center" > Sorry there is No Product in Invoice</td></tr>
                                    }
                                       
                                    </tbody>
                                </table>
                          
                            </div>
                            <!-- /.col -->
                        </div>
                        <!-- /.row -->

                        <div class="row">
                            <!-- accepted payments column -->
                            <div class="col-md-6">
                               @* <p class="lead">Payment Methods:</p>
                                <img src="images/visa.png" alt="Visa">
                                <img src="images/mastercard.png" alt="Mastercard">
                                <img src="images/american-express.png" alt="American Express">
                                <img src="images/paypal.png" alt="Paypal">
                                <p class="text-muted well well-sm no-shadow" style="margin-top: 10px;">
                                    Etsy doostang zoodles disqus groupon greplin oooj voxy zoodles, weebly ning heekya handango imeem plugg dopplr jibjab, movity jajah plickers sifteo edmodo ifttt zimbra.
                                </p>*@
                            </div>
                            <!-- /.col -->
                            <div class="col-md-6">
                                <p class="lead">Payed Amount  @Model.Date.ToShortDateString()</p>
                                <div class="table-responsive">
                                    <table class="table">

                                        <tbody>

                                            @if (Model.PayedQuantities.Count != 0)
                                            {
                                                @foreach (Payed_quantity payeditem in Model.PayedQuantities)
                                                {
                                                    <tr>
                                                        <th id="valueId">@payeditem.value LE </th>
                                                        <td>@payeditem.Date_Payed</td>
                                                        <td class="no-print"><a asp-action="Edit" asp-controller="payedQuantity" asp-route-id="@payeditem.ID" class="btn btn-info">Edit</a></td>
                                                        <td class="no-print"> <a asp-action="Delete" asp-controller="payedQuantity" asp-route-id="@payeditem.ID" class="btn btn-danger" onclick="return DeleteItem()">Delete</a></td>
                                                    </tr>
                                                }
                                            }else{
                                                <tr><td colspan="4" style="text-align:center"sty><h4> Sorry ,there is no payed Quantity yet ! </h4></td></tr>
                                            }

                                        </tbody>
                                    </table>
                                </div>
                            </div>
                            <!-- /.col -->
                            <!-- /.col -->
                            <div class="col-md-6">
                                <p class="lead">Amount Due @Model.Date.ToShortDateString()</p>
                                <div class="table-responsive">
                                    <table class="table">
                                        <tbody>
                                            <tr>
                                                <th style="width:50%">Total Price:</th>
                                                <td colspan="2" col>@Model.Total_Price LE</td>
                                            </tr>
                                            <tr>
                                                <th style="width:50%">Total payed:</th>
                                                <td colspan="2" col>@totalpayed LE</td>
                                            </tr>
                                            <tr>
                                                <th>The remaining quantity: </th>
                                                <td colspan="2" col>@remainingQ LE</td>
                                            </tr>
                                        </tbody>
                                    </table>
                                     @if (totalpayed >= Model.Total_Price)
                                        { 
                                        <button disabled class="btn btn-primary pull-right no-print" style="margin-right: 5px;" asp-controller="payedQuantity" asp-action="Create" asp-route-id="@Model.ID"> <i class="fa fa-credit-card"></i> Add new payed Quanit</button>
                                        }
                                        else
                                        {
                                            <a class="btn btn-primary pull-right no-print" style="margin-right: 5px;" asp-controller="payedQuantity" asp-action="Create" asp-route-id="@Model.ID"><i class="fa fa-credit-card"></i>Add new payed Quanity </a>
                                        }
                                  
                                </div>
                            </div>
                            <!-- /.col -->
                          
                        </div>
                        <!-- /.row -->
                        <!-- this row will not appear when printing -->
                        <div class="row no-print">
                            <div class=" ">
                                @if (Model.Bill_State == false)
                                { <a asp-action="Add" asp-controller="BillProduct" asp-route-id="@Model.ID" class="btn btn-primary pull-right" style="margin-right: 5px;color:white;">Add Product</a>                    
                                    <form asp-action="ConfirmSelling" asp-controller="BillProduct" method="post">
                                        <input asp-for="ID" hidden/>
                                                <button class="btn btn-success pull-right"><i class="fa fa-credit-card"></i>Confirm Selling</button>						                   
                                    </form>
                                }else{   <p>The client recevied All product in this bill </p>
                                    <p style="color:red;"><strong>Bill is Sold</strong> </p>
                                }

                               @* <button class="btn btn-default" onclick="window.print();"><i class="fa fa-print"></i> Print</button>
                                <button class="btn btn-success pull-right"><i class="fa fa-credit-card"></i> Submit Payment</button>
                                <button class="btn btn-primary pull-right" style="margin-right: 5px;"><i class="fa fa-download"></i> Generate PDF</button>*@
                            </div>
                        </div>
                    </section>
                </div>
            </div>
        </div>
    </div>
</div>
<br>
<br />
