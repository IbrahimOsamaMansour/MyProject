@model Project.Models.Bill

@{
    ViewData["Title"] = "Edit";
    Layout = "~/Views/Shared/_CustomLayout.cshtml";
}
<link rel="stylesheet" href="~/css/ProjectStyle.css">
<h1>Bill Information</span></h1>


<hr />
<div class="row x_panel" style="margin-left:20%; width:60%" onload="onloadfun()">
    <h2>Edit <span style="color:#17a2b8"> Bill Information</span> </h2>
    <hr />

    <div>
        <form asp-action="Edit" name="creatCatForm">
            <div asp-validation-summary="ModelOnly" class="text-danger"></div>
            <input type="hidden" asp-for="ID" />
            <div class="form-group">
                <label asp-for="Bill_Num" class="control-label"> Bill number</label>
                <input asp-for="Bill_Num" class="form-control" />
                <span asp-validation-for="Bill_Num" class="text-danger"></span>
            </div>
            <div class="form-group">
                <label asp-for="Client_Name" class="control-label"> Client name </label>
                <input asp-for="Client_Name" class="form-control" />
                <span asp-validation-for="Client_Name" class="text-danger"></span>
            </div>
            <div class="form-group form-check">
               @* <label class="form-check-label" >*@
                    <input class="form-check-input" asp-for="Bill_State" hidden /> @*@Html.DisplayNameFor(model => model.Bill_State)*@
                @*</label>*@
            </div>
            <div class="form-group form-check">
               @* <label class="form-check-label" >*@
                    <input class="form-check-input" asp-for="sell_State" hidden /> @*@Html.DisplayNameFor(model => model.sell_State)*@
               @* </label>*@
            </div>
            <div class="form-group">
                <label asp-for="Date" class="control-label"> Date </label>
                <input asp-for="Date" class="form-control"  />
                <span asp-validation-for="Date" class="text-danger"></span>
            </div>
            <div class="form-group">
                <label asp-for="Exp_Date" class="control-label"> Expired Date</label>
                <input asp-for="Exp_Date" class="form-control" readonly />
                <span asp-validation-for="Exp_Date" class="text-danger"></span>
            </div>
            <div class="form-group">
                <label asp-for="Client_phone" class="control-label"> Client phone</label>
                <input asp-for="Client_phone" class="form-control" />
                <span asp-validation-for="Client_phone" class="text-danger"></span>
            </div>
            <div class="form-group">
                <label asp-for="Total_Price" class="control-label"> Total Price</label>
                <input asp-for="Total_Price" class="form-control" />
                <span asp-validation-for="Total_Price" class="text-danger"></span>
            </div>
            <div class="form-group">
                <label asp-for="Note" class="control-label"></label>
                <input asp-for="Note" class="form-control" />
                <span asp-validation-for="Note" class="text-danger"></span>
            </div>
            <div class="form-group">
                <input type="submit" onclick="return DeleteItem()" value="Save" class="btn btn-primary" />
            </div>
        </form>
    </div>
</div>

<div>
    <a asp-action="Index" class="backbtn"> <i class="fa fa-hand-o-left"></i>Back to emplyee Attendance</a>
</div>
<script type="text/javascript">
   
    //$(document).ready(function () {
    //    OldBillNem = document.forms["creatCatForm"]["Bill_Num"].value;
    //    console.log(OldBillNem);
    //});
    var OldBillNem;
    window.onload = (event) => {
     OldBillNem = document.forms["creatCatForm"]["Bill_Num"].value;
    console.log(OldBillNem);
        console.log("page is fully loaded");
    };
    //function onloadfun() {
       
    //    var OldBillNem = document.forms["creatCatForm"]["Bill_Num"].value;
    //    console.log(OldBillNem);

    //}

    function DeleteItem() {
        let x = document.forms["creatCatForm"]["Bill_Num"].value;
        console.log(x);
        if (x != OldBillNem){
            if (confirm("Are you sure you want to Edit the number Of Bill ...?")) {
                return true;
            }
            return false;
        } 
        
    }
</script>


