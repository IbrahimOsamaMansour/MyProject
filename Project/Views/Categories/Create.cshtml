@model Project.Models.Category

@{
    ViewData["Title"] = "Create";
    Layout = "~/Views/Shared/_CustomLayout.cshtml";
}
<link rel="stylesheet" href="~/css/ProjectStyle.css">

<h1>Categoried</h1>
<hr />

<div class="row x_panel" style="margin-left:20%; width:60%">
    <h2>Add <span style="color:#17a2b8">Category</span> </h2>
    <hr />

    <div>
        <form asp-action="Create">
            <div asp-validation-summary="ModelOnly" class="text-danger"></div>
            <div class="form-group">
                <label asp-for="Name" class="control-label"></label>
                <input asp-for="Name" class="form-control" />
                <span asp-validation-for="Name" class="text-danger"></span>
            </div>
            <div class="form-group">
                <input type="submit" value="Create" class="btn btn-primary" />
            </div>
        </form>
    </div>
</div>

<div style="margin-left:20%; width:60%">
    <a asp-action="Index" class="backbtn"> <i class="fa fa-hand-o-left"></i>Back to categories</a>
</div>





