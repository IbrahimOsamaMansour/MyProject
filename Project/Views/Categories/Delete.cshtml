<form asp-action="SaveDelete">
    <input type="hidden" asp-for="Id" />

    @if (Model.SubCategories.Count == 0)
    {
        <input type="submit" value="Delete" class="btn btn-danger" />
    }
    else
    {

        <input type="submit" value="Delete" onclick="return DeleteItem()" class="btn btn-danger" />
    }
</form>

