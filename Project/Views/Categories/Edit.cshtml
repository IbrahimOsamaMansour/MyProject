@model Project.Models.Category

@{
    ViewData["Title"] = "Edit";
    Layout = "~/Views/Shared/_CustomLayout.cshtml";
}
<head>
    <link rel="stylesheet" href="~/css/ProjectStyle.css">
    <style>
        body {
            color: #081726;
        }
    </style>
</head>

<h1>Category</h1>
<hr />


<div class="row x_panel" style="margin-left:20%; width:60%">
    <h2>Edit <span style="color:#17a2b8">Category</span> </h2>
    <hr />

    <div>
        <form name="creatCatForm" asp-action="saveEdit">
            <div asp-validation-summary="ModelOnly" class="text-danger"></div>
            <input type="hidden" asp-for="Id" class="form-control" />
            <div class="form-group">
                <label asp-for="Name" class="control-label fs-3" style="font-size:20px"></label>
                <input asp-for="Name" class="form-control" />
                <span asp-validation-for="Name" class="text-danger"></span>
            </div>

            <div class="form-group">
                <input type="submit" value="saveEdit" class="btn btn-primary" onclick="return validateForm()" />
            </div>
        </form>
    </div>
</div>

<div style="margin-left:20%; width:60%">
    <a asp-action="Index" class="backbtn">Back to Category </a>
   
</div>

<script type="text/javascript">
    function validateForm() {
        let x = document.forms["creatCatForm"]["Name"].value;
        if (x == "") {
            alert("Name must be filled out");
            return false;
        }
    }
</script>



