@model Company_Phone
@{
    ViewData["Title"] = "AddPhone";
    Layout = "~/Views/Shared/_CustomLayout.cshtml";
}

<h1>AddPhone</h1>
<hr />
<div class="row">
    <div class="col-md-12 col-sm-12 ">
        <div class="x_panel" style="margin-left:20%; width:60%">
            <div class="x_title">
                <h2>Edit Form </h2>

                <div class="clearfix"></div>
            </div>


            <div class="x_content">

                <div class="col-md-9" >
  <form asp-controller="Company" name="creatCatForm" asp-action="AddPhone" method="post">
<input asp-for="COMP_ID"  />
<div class="form-group">
    <label asp-for="Phone" class="control-label"></label>
    <input asp-for="Phone" class="form-control @* col-9 *@" />
    <span asp-validation-for="Phone" class="text-danger"></span>
</div>
    <input type="submit" onclick="return validateForm()" value="Save" class="btn btn-primary" />

</form>

<br />
<div>
    <a asp-action="Details" asp-route-id="@Model.COMP_ID"><i class="fa fa-hand-o-left"></i>Back to Detail</a>
</div>
<div>
    <a asp-action="Index"><i class="fa fa-hand-o-left"></i>Back to List</a>
</div>
</div>
</div>
</div>
</div>
</div>



<script type="text/javascript">
    function validateForm() {
        let x = document.forms["creatCatForm"]["Phone"].value;
        if (x == "") {
            alert("Phone Number must be filled out");
            //swal("Hello world!");
            return false;
        }
    }
</script>