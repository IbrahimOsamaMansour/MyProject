@model Project.Models.Company

@{
    ViewData["Title"] = "Delete";
    Layout = "~/Views/Shared/_CustomLayout.cshtml";
}




<h3 style="color:red">Are you sure you want to delete this?</h3>
<div>


    @if (TempData["delFail"] != null){<h4 class="alert alert-success">@TempData["delFail"]</h4>}
    <hr />
    @*//////////////////////  11/  24  ////////////////////*@
    @if (ViewBag.fail != null)
    {
        <h4 style="Color:red">Sorry Delete Quantity is Fail! </h4>
    }
    @if (TempData["deleteProduct"] != null)
    {
        <h4 class="alert alert-success">@TempData["deleteProduct"] If you want to delete Click <a asp-action="Index" asp-controller="Product" >here</a></h4>
    }
    @if (TempData["deletepurchasing"] != null)
    {
        <h4 class="alert alert-info">@TempData["deletepurchasing"] If you want to delete Click <a asp-action="Index" asp-controller="Purchasing">here</a> </h4>
    }
    @if (TempData["deletePhone"] != null)
    {
        <h4 class="alert alert-info">@TempData["deletePhone"] If you want to delete Click <a asp-action="Details" asp-route-id="@Model.ID">here</a></h4>
    }

    @*//////////////////////////////////////////////////////////////*@



    <!-- page content -->
    <div role="main">
        <div class="">
            <div class="clearfix"></div>

            <div class="row">
                <div class="col-md-12">
                    <div class="x_panel">

                        <div class="x_content">
                            <div class="row">
                                <div class="col-sm-4 mail_list_column">


                                    <div class="">
                                        <div class="well profile_view">
                                            <div class="col-sm-12">
                                                <h4 class="brief"><i>Company Info</i></h4>
                                                <div class="left col-sm-7">
                                                    <h2><i class="fa fa-building"></i>@Model.Name</h2>
                                                    <p><i class="fa fa-user"></i>@Model.PersonContact</p>
                                                    @*<p><strong>About: </strong> Web Designer / UI. </p>*@
                                                    <ul class="list-unstyled">
                                                        @if (ViewData["Phoneitem"] != null)
                                                        {
                                                            foreach (Company_Phone d in (List<Project.Models.Company_Phone>)ViewData["Phoneitem"])
                                                            {
                                                                @if (d.COMP_ID == @Model.ID)
                                                                {
                                                                    <li><i class="fa fa-phone"></i>@d.Phone </li>
                                                                }

                                                            }
                                                        }

                                                        @*  <li><i class="fa fa-phone"></i> Phone #: </li>*@
                                                    </ul>
                                                </div>
                                                <div class="right col-sm-5 text-center">
                                                    @*<img src="images/user.png" alt="" class="img-circle img-fluid">*@
                                                </div>
                                            </div>
                                            <div class=" bottom text-center">
                                                <div class=" col-sm-6 emphasis">
                                                    @*<p class="ratings">
                                                    <a>4.0</a>
                                                    <a href="#"><span class="fa fa-star"></span></a>
                                                    <a href="#"><span class="fa fa-star"></span></a>
                                                    <a href="#"><span class="fa fa-star"></span></a>
                                                    <a href="#"><span class="fa fa-star"></span></a>
                                                    <a href="#"><span class="fa fa-star-o"></span></a>
                                                    </p>*@
                                                </div>
                                                <div class=" col-sm-6 emphasis">
                                                    <a asp-action="Details" asp-route-id="@Model.ID" class="btn btn-success btn-sm">
                                                        <i class="fa fa-folder"></i>
                                                        Detail Company
                                                    </a>
                                                    <a asp-action="Edit" asp-route-id="@Model.ID" class="btn btn-info btn-sm">
                                                        <i class="fa fa-pencil"></i>
                                                        Edit Company
                                                    </a>

                                                     <form asp-action="vDelete">
                                                        <input type="hidden" asp-for="ID" />
                                                        <button type="submit" class="btn btn-danger btn-sm">
                                                            <i class="fa fa-trash-o"></i>Delete Company</button>
                                                    @*<a asp-action="Delete" asp-route-id="@Model.ID" >
                                                        <i class="fa fa-trash-o"> </i> Delete Company
                                                    </a>*@
                                                    </form>
                                                </div>
                                            </div>
                                            <a asp-action="Index">
                                                <i class="fa fa-hand-o-left"></i> Back
                                            </a>
                                        </div>
                                    </div>







                                    @* <h1>Category Details</h1>
                                    <hr />*@
                                    @*<div>
                                    <h5> Category ID </h5>
                                    <p> @Model.Id</p>

                                    </div>*@
                                    @*  <div>
                                    <h5> Category Name : </h5>
                                    <p style="font-size:20px"> @Model.Name</p>

                                    </div>
                                    <div>*@
                                    @* <div>
                                    <a class="btn btn-success" asp-action="Edit" asp-route-id="@Model.ID">Edit category</a>
                                    </div>
                                    <div>
                                    <a class="btn btn-info" asp-action="Create" asp-controller="SubCategory" asp-route-id="@Model.ID">Add Category </a>
                                    </div>
                                    <div>
                                    <a asp-action="Index" class="backbtn">Back to List</a>
                                    </div>*@

                                    @* </div>*@

                                </div>
                                <!-- /MAIL LIST -->
                                <!-- CONTENT MAIL -->
                                <div class="col-sm-7 mail_view">
                                    <div class="inbox-body">
                                    </div>

                                    <table id="datatable" class="table table-hover  table-striped" role="grid" aria-describedby="datatable_info">
                                        <thead>
                                            <tr>
                                                <th> Phone</th>
                                                <th colspan="2"></th>
                                            </tr>
                                        </thead>
                                        <tbody>

                                            @if (ViewData["Phoneitem"] != null)
                                            {
                                                foreach (Company_Phone d in (List<Project.Models.Company_Phone>)ViewData["Phoneitem"])
                                                {
                                                    @if (d.COMP_ID == @Model.ID)
                                                    {
                                                        <tr>
                                                            <td><i class="fa fa-phone"></i>@d.Phone</td>
                                                            <td><a class="btn btn-info" asp-action="Editphone" asp-route-phone="@d.Phone" asp-route-id="@d.id"><i class="fa fa-pencil"></i></a></td>
                                                            <td><a class="btn btn-danger" asp-action="DeletePhone" onclick="return DeleteItem()" asp-route-phone="@d.Phone" asp-route-id="@d.id"><i class="fa fa-trash-o"></i></a></td>

                                                        </tr>
                                                    }
                                                }
                                            }
                                            else
                                            {
                                                <tr class="Nosubcatmsg"> Sorry thete is No Phone For this Company !</tr>
                                            }
                                        </tbody>
                                    </table>
                                </div>
                                <!-- /CONTENT MAIL -->
                            </div>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>
    <!-- /page content -->
    @*<a asp-action="Index">
        <i class="fa fa-hand-o-left"></i> Back
    </a>
    <form asp-action="vDelete">
        <input type="hidden" asp-for="ID" />
        <input type="submit" value="Delete" class="btn btn-danger btn-lg" /> 
    </form>*@
