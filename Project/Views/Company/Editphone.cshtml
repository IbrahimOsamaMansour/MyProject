@model Project.Models.Company_Phone

@{
    ViewData["Title"] = "Editphone";
    Layout = "~/Views/Shared/_CustomLayout.cshtml";
}

<h1>Edit phone</h1>


<hr />
<div class="row">
    <div class="col-md-12 col-sm-12 ">
        <div class="x_panel">
            <div class="x_title">
                <h2>Edit Form </h2>

                <div class="clearfix"></div>
            </div>


            <div class="x_content">
                <div class="col-md-3" style="margin-left:20%; width:60%">
        <form  asp-action="Editphone">
@*            <div asp-validation-summary="All" class="text-danger"></div>
*@            <input type="hidden" asp-for="COMP_ID" />
            <input type="hidden" asp-for="id" />

            <div class="form-group">
                <label asp-for="Phone" class="control-label"></label>
                <input asp-for="Phone" class="form-control" />
                <span asp-validation-for="Phone" class="text-danger"></span>

            </div>
          
            <div class="form-group">
                <input type="submit"  value="Save" class="btn btn-primary" />
            </div>
        </form>
    </div>
</div>
</div>
</div>
</div>
<div style="margin-left:20%; width:60%">
    <a asp-action="Details" asp-route-id="@Model.COMP_ID"><i class="fa fa-hand-o-left"></i>Back to Detail</a>
</div>
<div style="margin-left:20%; width:60%">
    <a asp-action="Index"><i class="fa fa-hand-o-left"></i>Back to List</a>
