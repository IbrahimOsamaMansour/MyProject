@model Project.Models.Emp_Attendance

@{
    ViewData["Title"] = "Delete";
    Layout = "~/Views/Shared/_CustomLayout.cshtml";
}
<link rel="stylesheet" href="~/css/ProjectStyle.css">

@*<h1>Delete</h1>*@

@if(ViewBag.AttendanceFail != null )
{
<h4 style="Color:red">Sorry Delete Attendance is Fail! </h4>
}

<div class="row x_panel" style="margin-left:20%; width:65%">
    <h2>Delete <span style="color:#17a2b8">Attendance</span> </h2>
    <hr />
    <div>
        <h3 style="Color:red">Are you sure you want to delete this Attendance?</h3>
        <hr />

        <dl class="row">
            <dt class="col-sm-2">
                @Html.DisplayNameFor(model => model.OverTime)
            </dt>
            <dd class="col-sm-10">
                @Html.DisplayFor(model => model.OverTime)
            </dd>
            <dt class="col-sm-2">
                @Html.DisplayNameFor(model => model.Date)
            </dt>
            <dd class="col-sm-10">
                @Html.DisplayFor(model => model.Date)
            </dd>
            <dt class="col-sm-2">
                @Html.DisplayNameFor(model => model.Attendance)
            </dt>
            <dd class="col-sm-10">
                @Html.DisplayFor(model => model.Attendance)
            </dd>
            <dt class="col-sm-2">
                @Html.DisplayNameFor(model => model.Workers)
            </dt>
            <dd class="col-sm-10">
                @Html.DisplayFor(model => model.Workers.Name)
            </dd>
        </dl>

        <hr />
        <form asp-action="Delete">
            <input type="hidden" asp-for="ID" />
            <input type="submit" value="Delete" class="btn btn-danger" /> 
        </form>
    </div>
</div>

<div>
    <a asp-action="Index" class="backbtn"> <i class="fa fa-hand-o-left"></i>Back to Attendance</a>
</div>

