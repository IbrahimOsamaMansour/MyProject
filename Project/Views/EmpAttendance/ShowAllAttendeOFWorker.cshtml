@model IEnumerable<Project.Models.Emp_Attendance>
@{
    ViewData["Title"] = "ShowAllAttendeOFWorker";
    Layout = "~/Views/Shared/_CustomLayout.cshtml";
}
<style>
    .ms-n5 {
        margin-left: -40px;
    }</style>
<link rel="stylesheet" href="~/css/ProjectStyle.css">
<h1>Attendance OF Worker</h1>
<hr />
<p>
    <a asp-action="Create">Create New</a>
</p>
<br />

<div class="clearfix"></div>
<div class="col-md-12 col-sm-12 ">
    <div class="x_panel">


        <div class="x_title row">
            <h3 class="col-11"></h3>

            <div class="col-1  justify-content-end">
                <ul class="nav navbar-right panel_toolbox @*col-4*@">

                    <li>
                        <a class="collapse-link"><i class="fa fa-chevron-up"></i></a>
                    </li>

                    <li>
                        <a class="close-link"><i class="fa fa-close"></i></a>
                    </li>
                </ul>

            </div>
            <div class="clearfix "></div>
        </div>


        <div class="x_content">
            <div class=" row">
                <h3 class="col-7"><a asp-action="Create" asp-controller="Categories" class="btn btn-info">Add Category </a></h3>

                <div class="col-5   " style="padding-top: 10px">
                    <div class="input-group ">
                        <input type="search" data-table="order-table" placeholder="Item to filter.." class=" table-filter form-control rounded" placeholder="Search" aria-label="Search" aria-describedby="search-addon" />
                        <button type="button" class="btn btn-outline-info">search</button>
                    </div>
                </div>
            </div>
            <table class="table table-hover  cd-table order-table table-striped">
                <thead>
                    <tr>
                        <th>
                            @Html.DisplayNameFor(model => model.Workers)
                        </th>
                        <th>
                            @Html.DisplayNameFor(model => model.OverTime)
                        </th>
                        <th>
                            @Html.DisplayNameFor(model => model.Date)
                        </th>
                        <th>
                            @Html.DisplayNameFor(model => model.Attendance)
                        </th>

                        <th></th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var item in Model)
                    {
                        <tr>
                            <td>
                                @Html.DisplayFor(modelItem => item.Workers.Name)
                            </td>
                            <td>
                                @Html.DisplayFor(modelItem => item.OverTime)
                            </td>
                            <td>
                                @Html.DisplayFor(modelItem => item.Date)
                            </td>
                            <td>
                                @Html.DisplayFor(modelItem => item.Attendance)
                            </td>
                            <td>
                                <a class="btn btn-outline-success" asp-action="Edit" asp-route-id="@item.ID">Edit</a>

                                <a class="btn btn-outline-info" asp-action="Details" asp-route-id="@item.ID">Details</a>

                                <a class="btn btn-outline-danger" asp-action="Delete" asp-route-id="@item.ID">Delete</a>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>

        </div>
    </div>
</div>

<div>
    <a asp-action="Index" class="backbtn">Back to Attendance</a>
</div>


