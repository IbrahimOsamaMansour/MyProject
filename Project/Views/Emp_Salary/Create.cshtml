@model Project.ViewModel.WorkerSalaryViewModel

@{
    ViewData["Title"] = "Create";
    Layout = "~/Views/Shared/_CustomLayout.cshtml";
    SelectList WorkerItemList = new SelectList(Model.workerlist, "ID", "Name");
}
<link rel="stylesheet" href="~/css/ProjectStyle.css">
<h1>Employee Salary</h1>

<hr />

<div class="row x_panel" style="margin-left:20%; width:60%">
    <h2>Add <span style="color:#17a2b8">Salary</span> </h2>
    <hr />

    <div>
        <form asp-action="Create">
            <div asp-validation-summary="ModelOnly" class="text-danger"></div>
            <div class="form-group">
                <label asp-for="TotalSalary" class="control-label"></label>
                <input asp-for="TotalSalary" class="form-control" />
                <span asp-validation-for="TotalSalary" class="text-danger"></span>
            </div>
            <div class="form-group">
                <label asp-for="Month" class="control-label"></label>
                <input asp-for="Month" class="form-control" />
                <span asp-validation-for="Month" class="text-danger"></span>
            </div>
            <div class="form-group">
                <label asp-for="Year" class="control-label"></label>
                <input asp-for="Year" class="form-control" />
                <span asp-validation-for="Year" class="text-danger"></span>
            </div>
            <div class="form-group">
                <label asp-for="AbsentDays" class="control-label"></label>
                <input asp-for="AbsentDays" class="form-control" />
                <span asp-validation-for="AbsentDays" class="text-danger"></span>
            </div>
            <div class="form-group">
                <label asp-for="WorkerID" class="control-label"></label>
                <select asp-for="WorkerID" class="form-control" asp-items="WorkerItemList"></select>
            </div>
            <div class="form-group">
                <input type="submit" value="Create" class="btn btn-primary" />
            </div>
        </form>
    </div>
</div>

<div style="margin-left:20%; width:60%">
    <a asp-action="Index" class="backbtn"> <i class="fa fa-hand-o-left"></i>Back to Salaries</a>
</div>


