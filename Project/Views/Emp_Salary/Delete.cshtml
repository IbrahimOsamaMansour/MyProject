@model Project.Models.Emp_Salary

@{
    ViewData["Title"] = "Delete";
    Layout = "~/Views/Shared/_CustomLayout.cshtml";
}
<link rel="stylesheet" href="~/css/ProjectStyle.css">
<h1>Delete</h1>
@if(TempData["DeleteAttend"] != null)
{
    <h4 class="alert alert-success">@TempData["DeleteAttend"] If you want to delete Click <a asp-action="Index" asp-controller="EmpAttendance" >here</a></h4>

}

@if (ViewBag.SalaryeFail != null)
{
    <h4 style="Color:red">Sorry Delete Attendance is Fail! </h4>
}

<div class="row x_panel" style="margin-left:20%; width:60%">
    <h2 style="font-weight: bolder;">Delete Salary</h2>
    <hr />
    <div>
        <h3 style="Color:red">Are you sure you want to delete this Salary ?</h3>
        <hr />

        <dl class="row">
            <dt class="col-sm-2">
                @Html.DisplayNameFor(model => model.TotalSalary)
            </dt>
            <dd class="col-sm-10">
                @Html.DisplayFor(model => model.TotalSalary)
            </dd>
            <dt class="col-sm-2">
                @Html.DisplayNameFor(model => model.Month)
            </dt>
            <dd class="col-sm-10">
                @Html.DisplayFor(model => model.Month)
            </dd>
            <dt class="col-sm-2">
                @Html.DisplayNameFor(model => model.Year)
            </dt>
            <dd class="col-sm-10">
                @Html.DisplayFor(model => model.Year)
            </dd>
            <dt class="col-sm-2">
                @Html.DisplayNameFor(model => model.AbsentDays)
            </dt>
            <dd class="col-sm-10">
                @Html.DisplayFor(model => model.AbsentDays)
            </dd>
            <dt class="col-sm-2">
                @Html.DisplayNameFor(model => model.Worker)
            </dt>
            <dd class="col-sm-10">
                @Html.DisplayFor(model => model.Worker.Name)
            </dd>
        </dl>

        <hr />
        <form asp-action="Delete">
            <input type="hidden" asp-for="ID" />
            <input type="submit" value="Delete" class="btn btn-danger" />
        </form>
        
    </div>
</div>

<div>
    <a asp-action="Index" class="backbtn"> <i class="fa fa-hand-o-left"></i>Back to Salary</a>
</div>


