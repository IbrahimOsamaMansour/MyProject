@model Expenses
@{
    ViewData["Title"] = "Details";
    Layout = "~/Views/Shared/_CustomLayout.cshtml";
}

<h1>Details</h1>


<div class="x_panel">
    <div class="x_title">
        <h2>@Model.Value LE</h2>
        <ul class="nav navbar-right panel_toolbox">
            <li>
                <a class="collapse-link"><i class="fa fa-chevron-up"></i></a>
            </li>
        </ul>
        <div class="clearfix"></div>
    </div>
    <div class="x_content" style="display: block;">
        <div class="row">
            <div class="col-sm-12">
                <div class="card-box table-responsive">
                    <div id="datatable_wrapper" class="dataTables_wrapper container-fluid dt-bootstrap no-footer">
                        <div class="row">
                            <div class="col-sm-12">
                                <table id="datatable" class="table table-striped table-bordered dataTable no-footer" style="width: 100%;" role="grid" aria-describedby="datatable_info">
                                    <thead>
                                        <tr role="row">
                                            <th class="sorting_asc" tabindex="0" aria-controls="datatable" rowspan="1" colspan="1" aria-label="Name: activate to sort column descending" aria-sort="ascending" style="width: 148px;">Value</th>
                                            <th class="sorting" tabindex="0" aria-controls="datatable" rowspan="1" colspan="1" aria-label="Position: activate to sort column ascending" style="width: 233px;">Item Expenses</th>
                                            <th class="sorting" tabindex="0" aria-controls="datatable" rowspan="1" colspan="1" aria-label="Position: activate to sort column ascending" style="width: 233px;">Date</th>
                                            <th class="sorting" tabindex="0" aria-controls="datatable" rowspan="1" colspan="1" aria-label="Position: activate to sort column ascending" style="width: 233px;">Employee</th>
                                            <th class="sorting" tabindex="0" aria-controls="datatable" rowspan="1" colspan="1" aria-label="Position: activate to sort column ascending" style="width: 233px;">Note</th>

                                        </tr>
                                    </thead>
                                    <tbody>
                                        <tr>
                                            <td>
                                                @Html.DisplayFor(model => model.Value) LE
                                            </td>
                                            <td>
                                                @Html.DisplayFor(model => model.Itemexpense.Name)
                                            </td>
                                            <td>
                                                @Html.DisplayFor(model => model.Expense_Date)
                                            </td>
                                            <td>
                                                @Html.DisplayFor(model => model.employee.UserName)
                                            </td>
                                            <td>
                                                @Html.DisplayFor(model => model.note)
                                            </td>
                                        </tr>
                                    </tbody>
                                </table>
                            </div>
                        </div>
                        <div>
                            <a asp-action="Edit" class="btn btn-success" asp-route-id="@Model.ID">Edit</a> 
                            <a asp-action="SaveDelete" class="btn btn-danger" asp-route-id="@Model.ID">Delete</a> 

                            <a class="btn btn-dark" asp-action="ShowAllExpenses">Back to List</a>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>