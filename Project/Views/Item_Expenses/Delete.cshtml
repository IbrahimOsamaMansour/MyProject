</div>

@*=======================================================*@


<div class="x_panel col-6" style="margin-left:20%; width:60%">
	<div class="x_title ">
		<h2>Delete <span style="color:#17a2b8">Item Expenses</span></h2>
		<ul class="nav navbar-right panel_toolbox">
