@model List<Purchasing>
@{
    ViewData["Title"] = "Index";
    Layout = "~/Views/Shared/_CustomLayout.cshtml";
}



<h1 style="font-weight:bolder ; color:#2a3f54"> Purchesing </h1>


    <div class="page-title">
        <div class="title_left">
        </div>

    </div>


<div class="clearfix"></div>
<div class="row" style="display: block;">
<div class="col-md-12 col-sm-12  ">
    <div class="x_panel">
        <div class="x_title">
            <h2>Purchasing </h2>
            <ul class="nav navbar-right panel_toolbox">
                <li>
                    <a class="collapse-link"><i class="fa fa-chevron-up"></i></a>
                </li>
                <li>
                    <a class="close-link"><i class="fa fa-close"></i></a>
                </li>
            </ul>
            <div class="clearfix"></div>
        </div>
        <div class="x_content">
            <div class="row" >
                    <h4 class="col-7"><a asp-action="add" class="btn btn-info btn-lg">Add Purchesing</a></h4>
                      <div class="col-5">
                        <div class="input-group " style="padding-top: 10px">
                        <input type="search" data-table="order-table" placeholder="Item to filter.." class=" table-filter form-control rounded" placeholder="Search" aria-label="Search" aria-describedby="search-addon" />
                        <button type="button" class="btn btn-outline-info">search</button>
                    </div>
                </div>
            </div>
              
                

                @if(TempData["sucDelete"] != null){<h4 class="alert alert-info">@TempData["sucDelete"]</h4>}
                <table class="order-table    table table-hover cd-table order-table table-striped">
                <thead>
                    <tr>
                        <th>company</th>
						<th>category </th>
						<th>sub category</th>
						<th>Model Name</th>
						<th>Bill Number </th>
						<th>date sell</th>
                            <th></th>
                            <th></th>
						<th colspan="4"></th>
                    </tr>
                </thead>
                <tbody>
                    @if(Model.Count !=0){

                        
                    
                    @foreach (var item in Model)
                    {
                        <tr>
                                @if(item.Company != null){<td>@item.Company.Name</td>}
					            else{<td>----</td>}
					            @if(item.category != null){<td>@item.category.Name</td>}
					            else{<td>----</td>}
					            @if(item.subcategory != null){<td>@item.subcategory.Name</td>}
					            else{<td>----</td>}
					            @if(item.ModelName != null){<td>@item.ModelName</td>}
					            else{<td>----</td>}
					            @if(item.BillNum != null){<td>@item.BillNum</td>}
					            else{<td>----</td>}
					            @if(item.DateSell != null){<td>@item.DateSell</td>}
                                @if (item.Purchasing_Quantities.Count != 0 )
                                {
                                    <td>
                                        @foreach (Purchasing_Quantity itemquantity in item.Purchasing_Quantities)
                                        {
                                            <p>@itemquantity.ValueQuantity  @itemquantity.UnitQuantity</p>
                                            <p>--------</p>
                                        }
                                        </td>
                                }
					            else{<td></td>}
                                    <td> <a asp-action="Detail" asp-route-id="@item.ID" class="btn btn-outline-success">Details</a></td>
                                    <td> <a asp-action="editPurchaching" asp-route-id="@item.ID" class="btn btn-outline-primary">Edit</a></td>
                                    <td> <a asp-action="addPurchasingProduct" asp-route-id="@item.ID" class="btn btn-outline-info">Add Product</a></td>
                            </tr>
                    }
                    }else{
                            <tr><td style="text-align: center" rowspan="2" colspan="6"> Sorry there is No data here</td></tr>
                    }
                </tbody>
            </table>

        </div>
    </div>


    </div>                    
    </div>



<script>
    (function () {
        'use strict';

        var TableFilter = (function () {
            var Arr = Array.prototype;
            var input;

            function onInputEvent(e) {
                input = e.target;
                var table1 = document.getElementsByClassName(input.getAttribute('data-table'));
                Arr.forEach.call(table1, function (table) {
                    Arr.forEach.call(table.tBodies, function (tbody) {
                        Arr.forEach.call(tbody.rows, filter);
                    });
                });
            }

            function filter(row) {
                var text = row.textContent.toLowerCase();
                //console.log(text);
                var val = input.value.toLowerCase();
                //console.log(val);
                row.style.display = text.indexOf(val) === -1 ? 'none' : 'table-row';
            }

            return {
                init: function () {
                    var inputs = document.getElementsByClassName('table-filter');
                    Arr.forEach.call(inputs, function (input) {
                        input.oninput = onInputEvent;
                    });
                }
            };

        })();

        /*console.log(document.readyState);
          document.addEventListener('readystatechange', function() {
              if (document.readyState === 'complete') {
            console.log(document.readyState);
                  TableFilter.init();
              }
          }); */

        TableFilter.init();
    })();

</script>