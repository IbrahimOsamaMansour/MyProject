@model PurchasingQuantityViewModel
@{
ViewData["Title"] = "addQuantity";
Layout = "~/Views/Shared/_CustomLayout.cshtml";
SelectList quantitynits = new SelectList(Model.units);
}

<h1> Quantity</h1>
<div class="clearfix"></div>
<div class="row">
	<div class="col-md-12 col-sm-12 ">
		<div class="x_panel">
						<div class="x_title">
							<h2>Form Design </h2>
							<ul class="nav navbar-right panel_toolbox">
								<li><a class="collapse-link"><i class="fa fa-chevron-up"></i></a>
								</li>
								<li><a class="close-link"><i class="fa fa-close"></i></a>
								</li>
							</ul>
							<div class="clearfix"></div>
						</div>


	<div class="x_content">
							<br /> 
							@if(ViewBag.suc != null){<h4 class="alert alert-success">Insert Purchasing in Product is Done Successfull  </h4>}
							@if(ViewBag.fail  != null){<h4 class="alert alert-danger">Sorry Insert Purchasing is Fail! </h4>}


		<div id="wizard" class="form_wizard wizard_horizontal">

			<ul class="wizard_steps">
				<li>
					<a href="#step-1" class="done">
						<span class="step_no">1</span>
						<span class="step_descr">
							Step 1<br />
							<small>Data of prchasing </small>
						</span>
					</a>
				</li>
				<li>
					<a href="#step-2" class="selected">
						<span class="step_no">2</span>
						<span class="step_descr">
							Step 2<br />
							<small>Quantity of purchasing</small>
						</span>
					</a>
				</li>
				<li>
					<a href="#step-3" class="disabled">
						<span class="step_no">3</span>
						<span class="step_descr">
							Step 3<br />
							<small>Finshed</small>
						</span>
					</a>
				</li>
			</ul>
	@if(Model.purchasing != null){
			<table class="table table-bordered">
				<thead>
					<tr>
						<th>company</th>
						<th>category </th>
						<th>sub category</th>
						<th>Model Name</th>
						<th>Bill Number </th>
						<th>total price</th>
						<th>description</th>
						<th>date sell</th>
						<th></th>
					</tr>
				</thead>
				<tbody>
					<tr>
						@if(Model.purchasing.Company != null){<td>@Model.purchasing.Company.Name</td>}
						else{<td>----</td>}
						@if(Model.purchasing.category != null){<td>@Model.purchasing.category.Name</td>}
						else{<td>----</td>}
						@if(Model.purchasing.subcategory != null){<td>@Model.purchasing.subcategory.Name</td>}
						else{<td>----</td>}
						@if(Model.purchasing.ModelName != null){<td>@Model.purchasing.ModelName</td>}
						else{<td>----</td>}
						@if(Model.purchasing.BillNum != null){<td>@Model.purchasing.BillNum</td>}
						else{<td>----</td>}
						@if(Model.purchasing.TotalPrice != null){<td>@Model.purchasing.TotalPrice</td>}
						else{<td>----</td>}
						@if(Model.purchasing.Description != null){<td>@Model.purchasing.Description</td>}
						else{<td>----</td>}
						@if(Model.purchasing.DateSell != null){<td>@Model.purchasing.DateSell</td>}
						else{<td>----</td>}
										
					</tr>									
				</tbody>
			</table>
					@if (Model.purchasing.Purchasing_Quantities.Count != 0) 
					{ 
						<table class="table table-bordered col-6">
							<thead>
								<tr>
									<th>Quantity </th>
									<th>unit </th>
								</tr>
							</thead>
							<tbody>
								@foreach (var item in Model.purchasing.Purchasing_Quantities)
								{
									<tr>
									@if(item.ValueQuantity != null ){<td>@item.ValueQuantity</td> <td>@item.UnitQuantity</td>}
									else{<td>----</td>}										
										
									</tr>
								}
																		
							</tbody>
					</table>
					}

			}

			<form asp-action="addQuantity" method="post" id="demo-form2" data-parsley-validate class="form-horizontal form-label-left">
						@if (TempData["Qua"] != null)
						{
							<p style="color:red">@TempData["Qua"]</p>
						}
								<input asp-for="Purch_id" hidden />										
								<div class="item form-group">
									<label asp-for="ValueQuantity"class="col-form-label col-md-3 col-sm-3 label-align" for="ValueQuantity">Quantity <span class="required">*</span>
									</label>
									<div class="col-md-6 col-sm-6 ">
										<input asp-for="ValueQuantity" placeholder="00" required="required" value="null" class="form-control">
										<span style="color:red" asp-validation-for="ValueQuantity"></span>
								@if (TempData["valQua"] != null)
								{
									<p style="color:red">@TempData["valQua"]</p>
								}
									</div>
								</div>

									<div class="item form-group">
									<label class="col-form-label col-md-3 col-sm-3 label-align" for="UnitQuantity"> Unit Quantity <span class="required">*</span>
									</label>
									<div class="col-md-6 col-sm-6 ">
							
										@if(quantitynits.Count() ==0 ){
										<select class="form-control" id="UnitQuantity" >
										<option value="null">No Unite quantity </option>
													
										</select>
										}else{
										<select class="form-control"asp-for="UnitQuantity" asp-items="quantitynits">
											<option value="null"> -- choose unite -- </option>

									</select>
								}<span style="color:red" asp-validation-for="UnitQuantity"></span>
									</div>
								</div>



								<div class="ln_solid"></div>
								<div class="item form-group">
									<div class="col-md-6 col-sm-6 offset-md-3">
										<button type="submit" class="btn btn-success">Submit</button>
									</div>
								</div>
							
							</form>

							<div class="ln_solid"></div>
							<div class="item form-group"  style="float: right">
								<div class="col-md-6 col-sm-6 offset-md-3">
								<a asp-action="addPurchasingProduct" asp-route-id="@Model.Purch_id" class="btn btn-success">Next <i class="fa fa-hand-o-right"></i></a>
								</div>
							</div>
							<div class="item form-group"  style="float: left">
								<div class="col-md-6 col-sm-6 offset-md-3">
									<a asp-action="add" class="btn btn-success"> <i class="fa fa-hand-o-left"></i>back </a>
								</div>
							</div>
							<br />
							<br />
							<div class="item form-group" style="float: left">
								<div class="col-md-6 col-sm-6 offset-md-3">
									<a asp-action="Detail" asp-route-id="@Model.Purch_id" class="btn btn-success ">Back to Detail <i class="fa fa-hand-o-left"></i></a>
								</div>
							</div>
							<div class="item form-group"  style="float: right">
								<div class="col-md-6 col-sm-6 offset-md-3">
								<a asp-action="index" class="btn btn-success ">Back to Purchasing <i class="fa fa-hand-o-right"></i></a>
								</div>
							</div>
						</div>
					</div>
				</div>
			</div>


</div>

