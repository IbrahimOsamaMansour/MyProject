<!DOCTYPE html>
@* Culture is resolved from the request localization cookie. *@
@{
    var isArabic = System.Globalization.CultureInfo.CurrentUICulture.Name.StartsWith("ar", StringComparison.OrdinalIgnoreCase);
}
<html lang="@(isArabic ? "ar" : "en")" dir="@(isArabic ? "rtl" : "ltr")">
  <head>
    <meta http-equiv="Content-Type" content="text/html; charset=UTF-8">
    <!-- Meta, title, CSS, favicons, etc. -->
    <meta charset="utf-8">
    <meta http-equiv="X-UA-Compatible" content="IE=edge">
    <meta name="viewport" content="width=device-width, initial-scale=1">
    <link rel="icon" href="~/customlayout/images/favicon.ico" type="image/ico" />

    
    <title>Ceramica ElQaser | </title>

    <!-- Bootstrap -->
      <link href="cdn.datatables.net/1.10.20/css/jquery.dataTables.min.css">
    <link href="~/CustomLayout/vendors/bootstrap/dist/css/bootstrap.min.css" rel="stylesheet">
    <!-- Font Awesome -->
    <link href="~/CustomLayout/vendors/font-awesome/css/font-awesome.min.css" rel="stylesheet">

    <!-- bootstrap-daterangepicker -->
    <link href="~/CustomLayout/vendors/bootstrap-daterangepicker/daterangepicker.css" rel="stylesheet">
    <!-- bootstrap-datetimepicker -->
    <link href="~/CustomLayout/vendors/bootstrap-datetimepicker/build/css/bootstrap-datetimepicker.css" rel="stylesheet">
    <!-- Ion.RangeSlider -->
    <link href="~/CustomLayout/vendors/normalize-css/normalize.css" rel="stylesheet">
    <link href="~/CustomLayout/vendors/ion.rangeSlider/css/ion.rangeSlider.css" rel="stylesheet">
    <link href="~/CustomLayout/vendors/ion.rangeSlider/css/ion.rangeSlider.skinFlat.css" rel="stylesheet">
    <!-- Bootstrap Colorpicker -->
    <link href="~/CustomLayout/vendors/mjolnic-bootstrap-colorpicker/dist/css/bootstrap-colorpicker.min.css" rel="stylesheet">

    <link href="~/CustomLayout/vendors/cropper/dist/cropper.min.css" rel="stylesheet">



    <!-- iCheck -->
    <link href="~/CustomLayout/vendors/iCheck/skins/flat/green.css" rel="stylesheet">

    <!-- bootstrap-progressbar -->
    <link href="~/CustomLayout/vendors/bootstrap-progressbar/css/bootstrap-progressbar-3.3.4.min.css" rel="stylesheet">
    <!-- JQVMap -->
    @*<link href="~/CustomLayout/vendors/jqvmap/dist/jqvmap.min.css" rel="stylesheet" />*@
    <!-- bootstrap-daterangepicker -->
    <link href="~/CustomLayout/vendors/bootstrap-daterangepicker/daterangepicker.css" rel="stylesheet">
    <!-- Datatables -->

    <link href="~/CustomLayout/vendors/datatables.net-bs/css/dataTables.bootstrap.min.css" rel="stylesheet">
    <link href="~/CustomLayout/vendors/datatables.net-buttons-bs/css/buttons.bootstrap.min.css" rel="stylesheet">
    <link href="~/CustomLayout/vendors/datatables.net-fixedheader-bs/css/fixedHeader.bootstrap.min.css" rel="stylesheet">
    <link href="~/CustomLayout/vendors/datatables.net-responsive-bs/css/responsive.bootstrap.min.css" rel="stylesheet">
    <link href="~/CustomLayout/vendors/datatables.net-scroller-bs/css/scroller.bootstrap.min.css" rel="stylesheet">

    <!-- Custom Theme Style -->
    <link href="~/CustomLayout/build/css/custom.min.css" rel="stylesheet">
    <link href="~/css/ProjectStyle.css" rel="stylesheet">
    <link href="~/css/rtl.css" rel="stylesheet" asp-append-version="true" />
    <link href="~/css/responsive.css" rel="stylesheet" asp-append-version="true" />
  </head>

  <body class="nav-md">
    <div class="container body">
      <div class="main_container">
        <div class="col-md-3 left_col">
          <div class="left_col scroll-view">
            <div class="navbar nav_title" style="border: 0;">
              <a href="#" class="site_title"><span dir="ltr">Marble ElQaser!</span></a>
            </div>

            <div class="clearfix"></div>

            <!-- menu profile quick info -->
            <div class="profile clearfix">
              <div class="profile_pic">
                <img src="/CustomLayout/images/img.jpg" alt="..." class="img-circle profile_img">
              </div>
              <div class="profile_info">
                <span>Welcome,</span>
                <h2><bdi>@User.Identity.Name</bdi></h2>
              </div>
            </div>
            <!-- /menu profile quick info -->

            <br />

            <!-- sidebar menu -->
                    @Html.Partial("_CustomNavLayout")
            <!-- /sidebar menu -->

            <!-- /menu footer buttons -->
            <div class="sidebar-footer hidden-small">
              <a data-toggle="tooltip" data-placement="top" title="Settings">
                <span class="glyphicon glyphicon-cog" aria-hidden="true"></span>
              </a>
              <a data-toggle="tooltip" data-placement="top" title="FullScreen">
                <span class="glyphicon glyphicon-fullscreen" aria-hidden="true"></span>
              </a>
              <a data-toggle="tooltip" data-placement="top" title="Lock">
                <span class="glyphicon glyphicon-eye-close" aria-hidden="true"></span>
              </a>
                        <a data-toggle="tooltip" data-placement="top" title="Logout" asp-controller="Account" asp-action="logout">
                <span class="glyphicon glyphicon-off" aria-hidden="true"></span>
              </a>
            </div>
            <!-- /menu footer buttons -->
          </div>
        </div>

        <!-- top navigation -->
        <div class="top_nav">
          <div class="nav_menu">
              <div class="nav toggle">
                <a id="menu_toggle"><i class="fa fa-bars"></i></a>
              </div>
              <nav class="nav navbar-nav">
              <ul class=" navbar-right">
                <li class="language-switcher" style="padding: 10px 12px;">
                    <form asp-controller="Language" asp-action="SetLanguage" method="post" class="language-form">
                        @Html.AntiForgeryToken()
                        <input type="hidden" name="returnUrl" value="@Context.Request.Path@Context.Request.QueryString" />
                        <div class="language-toggle" role="group" aria-label="Language">
                            <button type="submit" name="culture" value="en-US"
                                    class="language-toggle-option @(!isArabic ? "is-active" : "")"
                                    aria-label="@(isArabic ? "Switch to English" : "English is selected")"
                                    aria-pressed="@(!isArabic)">EN</button>
                            <button type="submit" name="culture" value="ar-EG"
                                    class="language-toggle-option @(isArabic ? "is-active" : "")"
                                    aria-label="@(!isArabic ? "Switch to Arabic" : "Arabic is selected")"
                                    aria-pressed="@isArabic">عربي</button>
                        </div>
                    </form>
                </li>
                <li class="nav-item dropdown" style="padding-left: 15px;">
                  <a href="javascript:;" class="user-profile dropdown-toggle" aria-haspopup="true" id="navbarDropdown" data-toggle="dropdown" aria-expanded="false">
                                    <img src="~/CustomLayout/images/img.jpg" alt=""><bdi>@User.Identity.Name</bdi>
                                </a>
                  <div class="dropdown-menu dropdown-usermenu pull-right" aria-labelledby="navbarDropdown">
                    <a class="dropdown-item"  href="javascript:;"> Profile</a>
                      <a class="dropdown-item"  href="javascript:;">
                        <span class="badge bg-red pull-right">50%</span>
                        <span>Settings</span>
                      </a>
                  <a class="dropdown-item"  href="javascript:;">Help</a>
                    <a class="dropdown-item"   asp-controller="Account" asp-action="logout" ><i class="fa fa-sign-out pull-right"></i> Log Out</a>
                  </div>
                </li>
                          
               
              </ul>
            </nav>
          </div>
        </div>
        <!-- /top navigation -->

         <div class="right_col" role="main">

              <div class="" >
                 <div class="tile_count">

                   @RenderBody()
      
              </div>
          </div>
      </div>

        <!-- footer content -->
        <footer>
          <div class="pull-right">
                    <a href="https://www.facebook.com/ceramiccleopatraelqasr1/about"> Ceramica ElQaser</a>
          </div>
          <div class="clearfix"></div>
        </footer>
        <!-- /footer content -->
      </div>
    </div>
