@model Project.Models.Bill


@if (Model.Product_Bills.Count != 0)
						{
							<table class="table table-bordered col-6">
								<thead>
									<tr>
										<th>Quantity </th>
										<th>unit </th>
										<th colspan="3"></th>
									</tr>
								</thead>
								<tbody>
									@foreach (var item in Model.Product_Bills)
									{
										<tr>
											<td>@item.product.ModelName</td>
											<td>@item.Quantity</td>
											<td>@item.unit_Quantity</td>
											<td>@item.unit_Price</td>
											<td>@item.Sell_Date</td>
											<td>@item.Book_Date</td>
											<td>@item.Resv_Q_State</td>
											<td><a asp-action="editQuantity" asp-route-id="@item.ID" class="btn btn-info">Edit</a></td>
											<td> <a asp-action="deleteQuantity" asp-route-id="@item.ID" class="btn btn-danger" onclick="return DeleteItem()">Delete</a></td>
										</tr>
									}

								</tbody>
							</table>
						}
						else
						{
							<h4> Sorry! there is no Quantity</h4>
						}

