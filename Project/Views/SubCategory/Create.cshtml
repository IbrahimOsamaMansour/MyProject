@model Category
@{
    ViewData["Title"] = "Create";
    Layout = "~/Views/Shared/_CustomLayout.cshtml";
}

<div class="x_panel" style="margin-left:20%; width:60%">
    <div class="x_title">
        <h2>Create <span style="color:#17a2b8">SubCategory</span></h2>
        <ul class="nav navbar-right panel_toolbox">
            <li>
                <a class="collapse-link"><i class="fa fa-chevron-up"></i></a>
            </li>
        </ul>
        <div class="clearfix"></div>
    </div>
    <div class="x_content" style="display: block;">
        <br>
        <form id="demo-form2" data-parsley-validate="" asp-action="Create" asp-controller="SubCategory" method="post" class="form-horizontal form-label-left" novalidate="">
            @if (Model.Suc_Categ_Id != null){<input asp-for="Suc_Categ_Id" hidden />}
            
            <div asp-validation-summary="All"  style="color:red"></div>
            <div class="item form-group">
                <label class="col-form-label col-md-3 col-sm-3 label-align" asp-for="Name"> SubCategory
                </label>
               

                <div class="col-md-6 col-sm-6 ">
                    <input asp-for="Name" required="required" class="form-control ">
                    <span class="text-danger" asp-validation-for="Name"></span>
                </div>
            </div>

            <div class="item form-group">

                <label class="col-form-label col-md-3 col-sm-3 label-align" asp-for="Suc_Categ_Id">Category
                </label>
                <span class="text-danger" asp-validation-for="Suc_Categ_Id"></span>

                <div class="col-md-6 col-sm-6 ">
                    @if(Model.Suc_Categ_Id!=null){
                        <select asp-for="Suc_Categ_Id" disabled asp-items="@ViewBag.categories as SelectList" required="required" class="form-control ">

                            <option value="NULL">--Please Select subCategory--</option>
                        </select>
                    }
                    else{
                        <select asp-for="Suc_Categ_Id" asp-items="@ViewBag.categories as SelectList" required="required" class="form-control ">
                            <option value="NULL">--Please Select subCategory--</option>
                        </select>
                    }
                    <span class="text-danger" asp-validation-for="Suc_Categ_Id"></span>
                </div>
            </div>

            <div class="item form-group">
                <div class="col-md-6 col-sm-6 offset-md-3">
                    
                    <button class="btn btn-primary" type="reset">Reset</button>
                    <input type="submit" class="btn btn-success" value="add">

                </div>
            </div>
        </form>
        <hr />
        <button type="button" class="btn btn-primary" asp-action="Index" asp-controller="SubCategory"><i class="fa fa-back"></i>Back</button>
    </div>
</div>