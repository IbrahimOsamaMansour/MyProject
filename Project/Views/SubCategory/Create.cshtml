@model Category
@{
    ViewData["Title"] = "Create";
    Layout = "~/Views/Shared/_CustomLayout.cshtml";
}

<div class="x_panel" style="width:60%; margin: 20px auto; float: none;">
    <div class="x_title">
        <h2>Create <span style="color:#17a2b8">SubCategory</span></h2>
        <ul class="nav navbar-right panel_toolbox">
            <li><a class="collapse-link"><i class="fa fa-chevron-up"></i></a></li>
        </ul>
        <div class="clearfix"></div>
    </div>

    <div class="x_content" style="display: block;">
        <br />
        <form asp-action="Create" asp-controller="SubCategory" method="post" class="form-horizontal form-label-left">
            @if (Model.Suc_Categ_Id != null)
            {
                <input asp-for="Suc_Categ_Id" type="hidden" />
            }

            <div class="item form-group" style="margin-bottom: 30px;">
                <label asp-for="Name" class="col-form-label col-md-3 col-sm-3 label-align">SubCategory</label>
                <div class="col-md-6 col-sm-6">
                    <input asp-for="Name" class="form-control" />
                    <span asp-validation-for="Name" class="text-danger"></span>
                </div>
            </div>

            <div class="item form-group" style="margin-bottom: 30px;">
                <label asp-for="Suc_Categ_Id" class="col-form-label col-md-3 col-sm-3 label-align">Category</label>
                <div class="col-md-6 col-sm-6">
                    @if (Model.Suc_Categ_Id != null)
                    {
                        <select asp-for="Suc_Categ_Id" disabled asp-items="@(ViewBag.categories as SelectList)" class="form-control">
                            <option value="">--Please Select Category--</option>
                        </select>
                    }
                    else
                    {
                        <select asp-for="Suc_Categ_Id" asp-items="@(ViewBag.categories as SelectList)" class="form-control">
                            <option value="">--Please Select Category--</option>
                        </select>
                    }
                    <span asp-validation-for="Suc_Categ_Id" class="text-danger"></span>
                </div>
            </div>

            <div class="item form-group">
                <div class="col-md-6 col-sm-6 col-md-offset-3">
                    <button class="btn btn-primary" type="reset">Reset</button>
                    <button class="btn btn-success" type="submit">Add</button>
                </div>
            </div>
        </form>
        <hr />
        <a asp-action="Index" asp-controller="SubCategory" class="btn btn-primary">Back</a>
    </div>
</div>
