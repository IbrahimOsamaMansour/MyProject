@model Category
@{
    ViewData["Title"] = "Edit";
    Layout = "~/Views/Shared/_CustomLayout.cshtml";
}


<div class="x_panel" style="margin-left:20%; width:60%">
    <div class="x_title">
        <h2>Edit <span style="color:#17a2b8">SubCategory</span></h2>
        <ul class="nav navbar-right panel_toolbox">
            <li>
                <a class="collapse-link"><i class="fa fa-chevron-up"></i></a>
            </li>
        </ul>
        <div class="clearfix"></div>
    </div>
    <div class="x_content" style="display: block;">
        <br>
        <form id="demo-form2" data-parsley-validate="" asp-action="Edit" asp-controller="SubCategory" method="post" class="form-horizontal form-label-left" novalidate="">

            <div class="item form-group">
                <label class="col-form-label col-md-3 col-sm-3 label-align" asp-for="Name">
                    SubCategory
                </label>

                <div class="col-md-6 col-sm-6 ">
                    <input asp-for="Name" required="required" class="form-control ">
                    <span class="text-danger" asp-validation-for="Name"></span>
                </div>
            </div>

            <div class="item form-group">

                <label class="col-form-label col-md-3 col-sm-3 label-align" asp-for="Suc_Categ_Id"> Category
                </label>

                <div class="col-md-6 col-sm-6 ">
                    <select asp-for="Suc_Categ_Id" asp-items="@ViewBag.categories as SelectList" required="required" class="form-control "></select>
                    <span class="text-danger" asp-validation-for="Suc_Categ_Id"></span>
                </div>
            </div>

            <div class="item form-group">
                <div class="col-md-6 col-sm-6 offset-md-3">
                    <button class="btn btn-primary" asp-action="Index" asp-controller="SubCategory">Back</button>
                    <button class="btn btn-primary" type="reset">Reset</button>
                    <input type="submit" class="btn btn-success" value="Update">

                </div>
            </div>
        </form>
    </div>
</div>