@model List<Category>

@{
    ViewData["Title"] = "Index";
    Layout = "~/Views/Shared/_CustomLayout.cshtml";
    int x = 1;
}
<br />

<h1 style="font-weight:bolder ; color:#2a3f54">SubCategories</h1>
<br />



@if (TempData["Added"] != null)
{
     <h3 class="alert alert-success">@TempData["Added"]</h3>
}
@if (TempData["Edit"] != null)
{
     <h3 class="alert alert-success">@TempData["Edit"]</h3>
}
@if (TempData["Delete"] != null)
{
     <h3 class="alert alert-success">@TempData["Delete"]</h3>
}
@if (TempData["subNotExist"] != null)
{
     <h3 class="alert alert-info">@TempData["subNotExist"]</h3>
}
@if (TempData["proudcthasSubCategory"] != null)
{
     <h3 class="alert alert-info">@TempData["proudcthasSubCategory"]</h3>
}
@if (TempData["purchashasSubCategory"] != null)
{
     <h3 class="alert alert-info">@TempData["purchashasSubCategory"]</h3>
}


<div class="clearfix"></div>

<div class="col-md-12 col-sm-12  ">
    <div class="x_panel">
        <div class="x_title">
            <ul class="nav navbar-right panel_toolbox">
                <li>
                    <a class="collapse-link"><i class="fa fa-chevron-up"></i></a>
                </li>
               
                <li>
                    <a class="close-link"><i class="fa fa-close"></i></a>
                </li>
            </ul>
            <div class="clearfix"></div>
        </div>
        <div class="x_content">

            <div class="row">
                <h3 class="col-7">
                    <a asp-action="Create" class="btn btn-info">Add SubCategory </a>
                </h3>
                <div class="col-4 " style="padding-top: 10px">
                    <p class="row">
                        <select onchange="categchang()" id="CategoryId" asp-items="ViewBag.categories" class="form-control "></select>
                    </p>
                </div>
              
            </div>
            <div id="divsubcateg">
              
                                <table id="datatable" class="table table-hover  table-striped   " role="grid" aria-describedby="datatable_info">
                    <thead>
                        <tr>
                            <th>#</th>
                            <th>Name</th>
                            <th>Category</th>
                            <th></th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var item in Model)
                        {
                            <tr>
                                <td>

                                    @(x++)
                                </td>
                                <td>
                                    @Html.DisplayFor(modelItem => item.Name)
                                </td>
                                <td>
                                    @Html.DisplayFor(modelItem => item.SubCategory.Name)
                                </td>
                                <td>
                                    <a asp-action="Edit" class="btn btn-outline-success" asp-route-id="@item.Id">Edit</a> 

                                    <a asp-action="Details" class="btn btn-outline-info" asp-route-id="@item.Id">Details</a> 

                                    <a asp-action="Delete" class="btn btn-outline-danger" asp-route-id="@item.Id" onclick="return DeleteItem()">Delete</a>
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>


            </div>


          

        </div>
    </div>
</div>














