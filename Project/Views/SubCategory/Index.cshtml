@section Categ_Change{
    <script type ="text/javascript">
       
        function categchang() {

            var categoryselect = document.getElementById("CategoryId");
            var divsubcateg = document.getElementById("divsubcateg");

            console.log(categoryselect.value);
            $.ajax({
                url: "http://localhost:5233/SubCategory/Filter/" + categoryselect.value,
                method: "post",
                success: function (result) {
                    console.log(result);
                    divsubcateg.innerHTML = result;
                }
            });
        }
        function DeleteItem() {
			if (confirm("Are you sure you want to delete ...?")) {
				return true;
			}
			return false;
		}
    </script>

