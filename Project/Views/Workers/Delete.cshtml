@model Project.Models.Workers

@{
    ViewData["Title"] = "Delete";
    Layout = "~/Views/Shared/_CustomLayout.cshtml";
}
<link rel="stylesheet" href="~/css/ProjectStyle.css">
@*@if (TempData["WorkerFail"] != null)
{
    <h4 class="alert alert-success">@TempData["WorkerFail"]</h4>
}*@
<hr />
@*//////////////////////  11/  24  ////////////////////*@

@if (TempData["WorkerFail"] != null)
{
    <h4 class="alert alert-success">@TempData["WorkerFail"] If you want to delete Click <a asp-action="Index" asp-controller="Product">here</a></h4>
}
@if (TempData["deleteEmpAttendance"] != null)
{
    <h4 class="alert alert-success">@TempData["deleteEmpAttendance"] If you want to delete Click <a asp-action="Index" asp-controller="Product">here</a></h4>
}
@if (TempData["deleteEmpSalary"] != null)
{
    <h4 class="alert alert-info">@TempData["deleteEmpSalary"] If you want to delete Click <a asp-action="Index" asp-controller="Purchasing">here</a> </h4>
}

<h3 class="pb-3" style="color:rgb(226, 11, 11);">Are you sure you want to delete this Worker ?</h3>
<div>
  
    <div class="p-2 mb-3" style="margin: auto; width:80%; border: 2px solid #2a3f54;">
        <div>
            <div>

                <div class="flex">
                    <ul class="list-inline widget_profile_box">
                        <li>
                            <a>
                                <i class="fa fa-facebook"></i>
                            </a>
                        </li>
                        <li>
                            <img src="~/images/user.png" alt="..." class="img-circle profile_img">
                        </li>
                        <li>
                            <a>
                                <i class="fa fa-twitter"></i>
                            </a>
                        </li>
                    </ul>
                </div>

                <h3 class="name pt-4"> @Html.DisplayFor(model => model.Name)</h3>
                <hr />

                <div>

                    <div class="row">
                        <dt class="col-sm-4">
                            @Html.DisplayNameFor(model => model.SSN)
                        </dt>
                        <dd class="col-sm-8">
                            @Html.DisplayFor(model => model.SSN)
                        </dd>
                    </div>

                    <div class="row">
                        <dt class="col-sm-4">
                            @Html.DisplayNameFor(model => model.Phone)
                        </dt>
                        <dd class="col-sm-8">
                            @Html.DisplayFor(model => model.Phone)
                        </dd>
                    </div>

                    <hr />
                    <div class="row pb-4">
                        <dt class="col-sm-4">
                            @Html.DisplayNameFor(model => model.NetSalary)
                        </dt>
                        <dd class="col-sm-8">
                            @Html.DisplayFor(model => model.NetSalary)
                        </dd>
                    </div>

                </div>


            </div>
        </div>
    </div>


    <form asp-action="Delete" class="mb-3">
        <input type="hidden" asp-for="ID" />
        <input type="submit" value="Delete" class="btn btn-danger" />
    </form>

    <a asp-action="Index" class="backbtn"><i class="fa fa-hand-o-left"></i>Back to Workers</a>
</div>



