<div class="p-2 mb-3" style="margin:auto; width:80%; border: 2px solid #2a3f54;">
    <div >
        <div>

            <div class="flex">
                <ul class="list-inline widget_profile_box">
                    <li>
                        <a>
                            <i class="fa fa-facebook"></i>
                        </a>
                    </li>
                    <li>
                        <img src="~/images/user.png" alt="..." class="img-circle profile_img">
                    </li>
                    <li>
