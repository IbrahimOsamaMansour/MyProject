                </dd>
                </div>

                <div class="row">
                    <dt class="col-sm-4">
                        @Html.DisplayNameFor(model => model.Phone)
                    </dt>
                    <dd class="col-sm-8">
                        @Html.DisplayFor(model => model.Phone)
                    </dd>
                </div>
               
                <hr />
                <div class="row pb-4">
                    <dt class="col-sm-4">
