@model IEnumerable<Project.Models.Workers>

@{
    ViewData["Title"] = "Index";
    Layout = "~/Views/Shared/_CustomLayout.cshtml";
    int x = 1;
}
<br />

<h1 style="font-weight:bolder ; color:#2a3f54"> Employee </h1>



@if (TempData["Done"] != null)
{
    <h4 class="alert alert-success">@TempData["Done"]</h4>
}
<br />



<div class="clearfix"></div>

<div class="col-md-12 col-sm-12  ">
    <div class="x_panel">
        <div class="x_title">
            <ul class="nav navbar-right panel_toolbox">
                <li>
                    <a class="collapse-link"><i class="fa fa-chevron-up"></i></a>
                </li>
              
                <li>
                    <a class="close-link"><i class="fa fa-close"></i></a>
                </li>
            </ul>
            <div class="clearfix"></div>
        </div>
        <div class="x_content">
           
               <div class="row">
                <h3 class="col-7">
                    <a asp-action="Create" class="btn btn-info">Add Employee </a>
                </h3>
                <div class="col-5" style="padding-top: 10px">
                    <div class="input-group">
                        <input type="search" data-table="order-table" placeholder="Item to filter.." class=" table-filter form-control rounded" placeholder="Search" aria-label="Search" aria-describedby="search-addon" />
                        <button type="button" class="btn btn-outline-info">search</button>
                    </div>
                </div>
              
            </div>
            <table class="table table-hover cd-table order-table table-striped">
                <thead>
                    <tr>
                        <th>

                            #
                        </th>
                        <th>
                            @Html.DisplayNameFor(model => model.Name)
                        </th>
                        <th>
                            @Html.DisplayNameFor(model => model.SSN)
                        </th>
                        <th>
                            @Html.DisplayNameFor(model => model.Phone)
                        </th>
                        <th>
                            @Html.DisplayNameFor(model => model.NetSalary)
                        </th>
                        <th></th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var item in Model)
                    {
                        <tr>
                            <th>

                                @(x++)
                            </th>
                            <td>
                                @Html.DisplayFor(modelItem => item.Name)
                            </td>
                            <td>
                                @Html.DisplayFor(modelItem => item.SSN)
                            </td>
                            <td>
                                @Html.DisplayFor(modelItem => item.Phone)
                            </td>
                            <td>
                                @Html.DisplayFor(modelItem => item.NetSalary)
                            </td>
                            <td>
                                <a class="btn btn-outline-success" asp-action="Edit" asp-route-id="@item.ID">Edit</a> 
                                <a class="btn btn-outline-info" asp-action="Details" asp-route-id="@item.ID">Details</a> 
                                <a class="btn btn-outline-danger" asp-action="Delete" asp-route-id="@item.ID">Delete</a>  

                                <a class="btn btn-outline-success" asp-action="CreateNewByWorkerid" asp-controller="EmpAttendance" asp-route-id="@item.ID">Add Attend</a>

                            </td>
                        </tr>
                    }
                </tbody>
            </table>

        </div>
    </div>
</div>







