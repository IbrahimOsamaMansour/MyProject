@model Project.Models.Payed_quantity

@{
    ViewData["Title"] = "Edit";
    Layout = "~/Views/Shared/_CustomLayout.cshtml";
}
<link rel="stylesheet" href="~/css/ProjectStyle.css">
<h1>Payed Quantity</h1>
<hr />

@if(TempData["editpayed"]!= null)
{
    <h4 class="alert alert-success"> @TempData["editpayed"]</h4>
}
@if (TempData["failpayedQEdit"] != null)
{
    <h4 class="alert alert-danger">@TempData["failpayedQEdit"]</h4>
}
@if (TempData["cantCreatePQ"] != null)
{
    <h4 class="alert alert-danger">@TempData["cantCreatePQ"]</h4>
}
<div class="clearfix"></div>

<div class="row x_panel" style="margin-left:20%; width:60%">
    <h2>Edit <span style="color:#17a2b8">Employee Salary</span> </h2>
    <hr />

    <div>
        <form name="creatCatForm" asp-action="Edit" method="post">
            <div asp-validation-summary="ModelOnly" class="text-danger"></div>
            <input type="hidden" asp-for="ID" />
            <input type="hidden" asp-for="Bill_ID" />
            <div class="form-group">
                <label asp-for="value" class="control-label"></label>
                <input asp-for="value" class="form-control" />
                <span asp-validation-for="value" class="text-danger"></span>
            </div>
            <div class="form-group">
                <label asp-for="Date_Payed" class="control-label"></label>
                <input asp-for="Date_Payed" class="form-control" />
                <span asp-validation-for="Date_Payed" class="text-danger"></span>
            </div>

            <div class="form-group">
                <input type="submit" value="Edit" class="btn btn-primary" onclick="return validateForm()" />
            </div>
        </form>
    </div>
</div>

<div>
    <a asp-controller="Bills" asp-action="Details" asp-route-id="@Model.Bill_ID" class="backbtn"> <i class="fa fa-hand-o-left"></i>Back to detailes</a>
</div>

<script type="text/javascript">
    function validateForm() {
        let x = document.forms["creatCatForm"]["value"].value;
        if (x == "") {
            alert(" the Value must be filled out !");
            return false;
        }
    }
</script>




